{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roonscape.local/schema/presentation-snapshot-v3.json",
  "title": "RoonScape presentation snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "availability",
    "playback",
    "trackedOutput",
    "trackedZone",
    "nowPlaying",
    "progress",
    "artwork",
    "lyrics"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Version of this complete snapshot contract.",
      "const": 3
    },
    "revision": {
      "description": "Monotonic presentation revision. A publisher MUST increase it whenever the presentation changes and MUST NOT reuse a lower value during its lifetime.",
      "type": "integer",
      "minimum": 0
    },
    "availability": {
      "enum": [
        "pairingRequired",
        "disconnected",
        "outputUnavailable",
        "available"
      ]
    },
    "playback": {
      "oneOf": [
        { "enum": ["playing", "paused", "loading", "stopped"] },
        { "type": "null" }
      ]
    },
    "trackedOutput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        },
        { "type": "null" }
      ]
    },
    "trackedZone": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        },
        { "type": "null" }
      ]
    },
    "nowPlaying": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "artist", "album"],
          "properties": {
            "title": {
              "type": ["string", "null"],
              "maxLength": 1024
            },
            "artist": {
              "type": ["string", "null"],
              "maxLength": 1024
            },
            "album": {
              "type": ["string", "null"],
              "maxLength": 1024
            }
          }
        },
        { "type": "null" }
      ]
    },
    "progress": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["positionSeconds", "durationSeconds", "sampledAt"],
          "properties": {
            "positionSeconds": { "type": "number", "minimum": 0 },
            "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
            "sampledAt": { "type": "string", "format": "date-time" }
          }
        },
        { "type": "null" }
      ]
    },
    "artwork": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "path"],
          "properties": {
            "revision": { "type": "integer", "minimum": 0 },
            "path": { "type": "string", "minLength": 1 }
          }
        },
        { "type": "null" }
      ]
    },
    "lyrics": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["cues"],
          "properties": {
            "cues": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["atSeconds", "text"],
                "properties": {
                  "atSeconds": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 86400
                  },
                  "text": { "type": "string", "maxLength": 512 }
                }
              }
            }
          }
        },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "availability": { "const": "available" } },
        "required": ["availability"]
      },
      "then": {
        "properties": {
          "playback": { "type": "string" },
          "trackedOutput": { "type": "object" },
          "trackedZone": { "type": "object" }
        }
      },
      "else": {
        "properties": {
          "playback": { "type": "null" },
          "nowPlaying": { "type": "null" },
          "progress": { "type": "null" },
          "artwork": { "type": "null" },
          "lyrics": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "availability": {
            "enum": ["pairingRequired", "disconnected"]
          }
        },
        "required": ["availability"]
      },
      "then": {
        "properties": {
          "trackedOutput": { "type": "null" },
          "trackedZone": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "availability": { "const": "outputUnavailable" } },
        "required": ["availability"]
      },
      "then": {
        "properties": {
          "trackedZone": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "playback": { "const": "stopped" } },
        "required": ["playback"]
      },
      "then": {
        "properties": {
          "nowPlaying": { "type": "null" },
          "progress": { "type": "null" },
          "artwork": { "type": "null" },
          "lyrics": { "type": "null" }
        }
      }
    }
  ]
}
